<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE dictionary SYSTEM "file://localhost/System/Library/DTDs/sdef.dtd">
<dictionary title="Holdfast Terminology">
    <suite name="Holdfast Suite" code="QKrd" description="Start, stop and configure recordings">
        <command name="record screen" code="QKrdSlsn" description="Select screen to record">
            <cocoa class="Holdfast.selectScreen"/>
            <parameter name="numbered" code="NUMb" type="integer" description="Screen number" optional="yes">
                <cocoa key="index"/>
            </parameter>
        </command>
        
        <command name="record screen area" code="QKrdSlar" description="Select screen area to record">
            <cocoa class="Holdfast.selectArea"/>
        </command>
        
        <command name="record application" code="QKrdSlap" description="Select apps to record">
            <cocoa class="Holdfast.selectApps"/>
            <parameter name="named" code="NAmd" type="text" description="Application Name" optional="yes">
                <cocoa key="name"/>
            </parameter>
        </command>
        
        <command name="record window" code="QKrdSlwd" description="Select windows to record">
            <cocoa class="Holdfast.selectWindows"/>
            <parameter name="titled" code="TItd" type="text" description="Window Title" optional="yes">
                <cocoa key="title"/>
            </parameter>
            <parameter name="in application" code="APli" type="text" description="Application Name" optional="yes">
                <cocoa key="app"/>
            </parameter>
        </command>
        
        <command name="record system audio" code="QKrdREad" description="Record system audio">
            <cocoa class="Holdfast.recordAudio"/>
            <parameter name="microphone" code="MIcp" type="boolean" description="Whether to record the microphone at the same time" optional="yes">
                <cocoa key="mic"/>
            </parameter>
        </command>
        
        <command name="stop recording" code="QKrdSTop" description="Stop the current recording, or cancel a running countdown. Returns at once; the file is saved in the background. A recording that is still starting up is stopped as soon as it runs. Does nothing if idle or if a recording is already being saved">
            <cocoa class="Holdfast.stopRecording"/>
        </command>
        
        <command name="mute microphone" code="QKrdMUte" description="Record silence in place of the microphone from now on. The recording goes on and its microphone track stays as long as the recording. Returns an error when no recording with a microphone is running">
            <cocoa class="Holdfast.muteMicrophone"/>
        </command>
        
        <command name="unmute microphone" code="QKrdUNmu" description="Record the microphone again after 'mute microphone'. Returns an error when no recording with a microphone is running">
            <cocoa class="Holdfast.unmuteMicrophone"/>
        </command>
        
        <command name="configure" code="QKrdSEtt" description="Modify recording settings">
            <cocoa class="Holdfast.setPreferences"/>
            <parameter name="hires" code="REsl" type="boolean" description="Recording in Retina resolution" optional="yes">
                <cocoa key="hires"/>
            </parameter>
            <parameter name="fps" code="FPss" type="integer" description="Set the recording frame rate" optional="yes">
                <cocoa key="fps"/>
            </parameter>
            <parameter name="quality" code="QLty" type="integer" description="Video quality (3=high, 2=medium, 1=low)" optional="yes">
                <cocoa key="quality"/>
            </parameter>
            <parameter name="cursor" code="MOus" type="boolean" description="Whether to record the cursor" optional="yes">
                <cocoa key="cursor"/>
            </parameter>
            <parameter name="sound" code="SUnd" type="boolean" description="Whether to record the system sound" optional="yes">
                <cocoa key="sound"/>
            </parameter>
            <parameter name="microphone" code="MIce" type="boolean" description="Whether to record the microphone" optional="yes">
                <cocoa key="microphone"/>
            </parameter>
            <parameter name="mic device" code="MCNa" type="text" description="The name of the audio input device (default is 'default'). The device must be connected; otherwise the command returns an error and the selection is not changed" optional="yes">
                <cocoa key="micname"/>
            </parameter>
            <parameter name="hdr" code="HDri" type="boolean" description="Whether to record in HDR mode" optional="yes">
                <cocoa key="hdr"/>
            </parameter>
        </command>
    </suite>
</dictionary>
